    "i18next": "^26.3.4",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^6.19.0",
    "qrcode-generator": "^2.0.4",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.1.1"
  }
