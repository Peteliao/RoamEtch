    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "promo:webp": "node tools/make-demo-webp.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
