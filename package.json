{
  "name": "roametch",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Pure-frontend trip recorder & analyzer with dual-region (CN/Global) adaptive service routing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peteliao/RoamEtch.git"
  },
  "homepage": "https://peteliao.github.io/RoamEtch/",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
